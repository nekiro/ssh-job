{
	"name": "ssh-job",
	"version": "2.0.0",
	"private": true,
	"description": "Github Action that allows to connect to server by ssh and execute actions",
	"main": "lib/main.js",
	"scripts": {
		"build": "tsc",
		"format": "prettier --write **/*.ts",
		"format-check": "prettier --check **/*.ts",
		"lint": "eslint src",
		"package": "ncc build --source-map --license licenses.txt",
		"test": "jest",
		"coverage": "jest --coverage --collectCoverageFrom='src/**/*.ts'",
		"all": "npm run build && npm run format && npm run lint && npm run package && npm test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nekiro/ssh-job.git"
	},
	"keywords": [
		"actions",
		"node",
		"ssh"
	],
	"author": "Marcin Jałocha",
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^1.11.1",
		"node-ssh": "^13.2.1",
		"validator": "^13.15.35"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/jest": "^29.5.14",
		"@types/node": "^24.19.4",
		"@types/ssh2": "^1.11.13",
		"@types/validator": "^13.15.10",
		"@vercel/ncc": "^0.38.4",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"jest": "^29.7.0",
		"prettier": "^3.0.0",
		"ts-jest": "^29.4.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.74.0"
	}
}
