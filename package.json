{
	"name": "ssh-job",
	"version": "2.2.0",
	"private": true,
	"type": "module",
	"description": "Github Action that allows to connect to server by ssh and execute actions",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc --noEmit",
		"format": "prettier --write **/*.ts",
		"format-check": "prettier --check **/*.ts",
		"lint": "eslint src",
		"package": "rolldown -c",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"all": "npm run build && npm run format && npm run lint && npm run package && npm test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nekiro/ssh-job.git"
	},
	"keywords": [
		"actions",
		"node",
		"ssh"
	],
	"author": "Marcin Jałocha",
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"node-ssh": "^14.0.0",
		"validator": "^13.15.35"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.4",
		"@types/ssh2": "^1.15.6",
		"@types/validator": "^13.15.10",
		"@vitest/coverage-v8": "^5.1.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"prettier": "^3.10.1",
		"rolldown": "^1.3.3",
		"rollup-plugin-license": "^3.7.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.74.0",
		"vitest": "^5.1.2"
	}
}
